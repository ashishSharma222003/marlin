# Copy this file to .env and fill in the values you need.

# --- App ---
DEBUG=true
CORS_ORIGINS=["*"]

# --- LLM: default chat model (provider is inferred from the model name) ---
LLM_MODEL=claude-sonnet-5

# Read directly from the environment by each provider's SDK — only the key
# for whichever provider(s) you actually use needs a value.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Storage (SQLite) ---
# Holds LangGraph's own conversation checkpoints (keyed by conversation_id
# as thread_id) plus our own `facts` table.
SQLITE_PATH=data/marlin.sqlite

# --- Conversation log ---
# Write-only JSON transcript per conversation, for humans/export/debugging.
CONVERSATIONS_LOG_DIR=data/conversations

# --- Vector memory (FAISS, in-memory) ---
VECTOR_DB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
