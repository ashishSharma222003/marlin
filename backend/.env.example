# Copy this file to .env and fill in the values you need.

# --- App ---
DEBUG=true
CORS_ORIGINS=["*"]

# --- LLM provider: "anthropic" or "openai" ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=marlin

# --- Vector DB (optional, not wired up yet) ---
VECTOR_DB_PROVIDER=
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
